JumpVisuals.SliderDot = SliderDotJump

local minJump = 50
local maxJump = 150
local function SetSliderVisualsJump(val)
    local percentage = (val - minJump) / (maxJump - minJump)
    percentage = math.clamp(percentage, 0, 1)
    SliderDotJump.Position = UDim2.new(percentage, -8, 0.5, -8)
    JumpLabel.Text = "Subtle Jump: " .. val .. (val == 50 and " (Default)" or "")
end

local function UpdateJump(input)
    if not subtleJumpEnabled then return end
    local pos = math.clamp((input.Position.X - SliderBarJump.AbsolutePosition.X) / SliderBarJump.AbsoluteSize.X, 0, 1)
    SliderDotJump.Position = UDim2.new(pos, -8, 0.5, -8)
    subtleJumpValue = math.floor(minJump + (pos * (maxJump - minJump)))
    JumpLabel.Text = "Subtle Jump: " .. subtleJumpValue .. (subtleJumpValue == 50 and " (Default)" or "")
end

local slidingJump = false
SliderBarJump.InputBegan:Connect(function(input)
    if not subtleJumpEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        slidingJump = true
        UpdateJump(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if slidingJump and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
         UpdateJump(input)
    end
end)
UserInputService.InputEnded:Connect(function() slidingJump = false end)

