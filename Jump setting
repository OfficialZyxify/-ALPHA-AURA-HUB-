-- =======================================================
-- 5.) Runtime Loop (Subtle Elevation Core Logic)
-- =======================================================
RunService.Heartbeat:Connect(function()
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character.PrimaryPart
         
        if hum and hrp then
            local isRising = hrp.AssemblyLinearVelocity.Y > 1
            if subtleJumpEnabled and not hum.Sit and isRising then
                local jumpDiff = math.max(0, subtleJumpValue - 50)
                local multiplier = jumpDiff * 0.018 
                if multiplier > 0 then
                    hrp.CFrame = hrp.CFrame + Vector3.new(0, multiplier, 0)
                end
            end
        end
    end
end)
