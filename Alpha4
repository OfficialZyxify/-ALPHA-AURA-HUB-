    SliderDotSpeed.Position = UDim2.new(percentage, -8, 0.5, -8)
    subtleSpeedValue = math.floor(16 + (percentage * 84))
    SpeedLabel.Text = "WalkSpeed Value: " .. subtleSpeedValue
