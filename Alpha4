-- Persistent Dragging and Panel Expansion Physics Engines
local expanded = false
local dragging = false
local dragStart = nil
local startPos = nil
local moved = false

local function UpdatePanelDragMovement(input)
    local delta = input.Position - dragStart
    local newX = startPos.X.Offset + delta.X
    local newY = startPos.Y.Offset + delta.Y
    
    if delta.Magnitude > 5 then moved = true end
    MainCircle.Position = UDim2.new(0, newX, 0, newY)
    
    local panelX = newX + 70
    if panelX + 230 > ScreenGui.AbsoluteSize.X then panelX = newX - 240 end
    MainPanel.Position = UDim2.new(0, panelX, 0, newY)
end

MainCircle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        moved = false
        dragStart = input.Position
        startPos = MainCircle.Position
        
        local dragConnection
        dragConnection = UserInputService.InputChanged:Connect(function(changedInput)
            if dragging and (changedInput.UserInputType == Enum.UserInputType.MouseMovement or changedInput.UserInputType == Enum.UserInputType.Touch) then
                UpdatePanelDragMovement(changedInput)
            end
        end)
        
        local upConnection
        upConnection = UserInputService.InputEnded:Connect(function(endInput)
            if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                if dragConnection then dragConnection:Disconnect() end
                if upConnection then upConnection:Disconnect() end
                
                if not moved then
                    expanded = not expanded
                    local buttonPos = MainCircle.Position
                    local panelX = buttonPos.X.Offset + 70
                    if panelX + 230 > ScreenGui.AbsoluteSize.X then panelX = buttonPos.X.Offset - 240 end
                    MainPanel.Position = UDim2.new(0, panelX, 0, buttonPos.Y.Offset)
                    
                    local targetSize = expanded and UDim2.new(0, 230, 0.65, 0) or UDim2.new(0, 0, 0.65, 0)
                    TweenService:Create(MainPanel, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = targetSize}):Play()
                end
            end
        end)
    end
end)

-- Runtime Metadata Telemetry Updaters
local lastTick = tick()
local frameCount = 0
local startTime = tick()

task.spawn(function()
    while task.wait(0.5) do
        if not ScreenGui or not ScreenGui.Parent then break end
        
        -- FPS engine calculation
        local now = tick()
        frameCount = frameCount + 1
        if now - lastTick >= 1 then
            local fps = math.floor(frameCount / (now - lastTick))
            
            -- Ping calculation
            local ping = "0"
            pcall(function()
                ping = string.format("%.0f", LocalPlayer:GetNetworkPing() * 1000)
            end)
            
            StatsLabel.Text = "Ping: " .. ping .. "ms | FPS: " .. fps
            frameCount = 0
            lastTick = now
        end
        
        -- Session Time configuration
        local duration = tick() - startTime
        local hours = math.floor(duration / 3600)
        local minutes = math.floor((duration % 3600) / 60)
        local seconds = math.floor(duration % 60)
        SessionLabel.Text = string.format("Session Duration: %02d:%02d:%02d", hours, minutes, seconds)
    end
end)

