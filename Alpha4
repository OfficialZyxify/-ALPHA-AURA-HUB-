local function UpdateFOVVisualEngine(dimmed)
    local targetColor = dimmed and Color3.fromRGB(90, 90, 90) or Color3.fromRGB(255, 255, 255)
    local rulerColor = dimmed and Color3.fromRGB(60, 60, 60) or Color3.fromRGB(180, 180, 180)
    local dotColor = dimmed and Color3.fromRGB(0, 100, 60) or Color3.fromRGB(0, 255, 140)
    
    for _, item in ipairs(FOVVisuals.ActiveItems) do
        if item:IsA("TextLabel") then
            item.TextColor3 = (item.Text:match("%d") and not item.Text:find("Field")) and rulerColor or targetColor
        end
    end
    SliderDotFOV.BackgroundColor3 = dotColor
    FOVNote.Visible = dimmed
end
UpdateFOVVisualEngine(true)

local function ApplyFOVSliderPosition(input)
    if not fovEnabled then return end
    local xOffset = math.clamp(input.Position.X - SliderBarFOV.AbsolutePosition.X, 0, SliderBarFOV.AbsoluteSize.X)
    local percentage = xOffset / SliderBarFOV.AbsoluteSize.X
    SliderDotFOV.Position = UDim2.new(percentage, -8, 0.5, -8)
    currentFOV = math.floor(70 + (percentage * 50))
    FOVLabel.Text = "Field of View: " .. currentFOV
    Camera.FieldOfView = currentFOV
end

local fovDragging = false
SliderBarFOV.InputBegan:Connect(function(input)
    if fovEnabled and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        fovDragging = true
        ApplyFOVSliderPosition(input)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if fovDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        ApplyFOVSliderPosition(input)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        fovDragging = false
    end
end)

