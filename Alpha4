                    if multiplier > 0 then
                        hrp.CFrame = hrp.CFrame + Vector3.new(0, multiplier, 0)
                    end
                end
            end
        end
    end)
end)

--// Panel HUD Statistics Sync Thread
task.spawn(function()
    local lastTick = tick()
    local frameCount = 0
    local startTime = tick()

    while task.wait(0.5) do
        if not ScreenGui.Parent then break end
        
        -- Safe Ping Query Check
        local pingVal = 0
        pcall(function()
            pingVal = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        
        -- Framerate Calculation
        local curTick = tick()
        frameCount = frameCount + 1
        local fps = math.floor(frameCount / (curTick - lastTick))
        if curTick - lastTick >= 1 then
            frameCount = 0
            lastTick = curTick
        end
        
        StatsLabel.Text = string.format("Ping: %dms | FPS: %d", math.floor(pingVal), fps)
        
        -- Session Time Calculation
        local deltaSession = tick() - startTime
        local hrs = math.floor(deltaSession / 3600)
        local mins = math.floor((deltaSession % 3600) / 60)
        local secs = math.floor(deltaSession % 60)
        SessionLabel.Text = string.format("Session Duration: %02d:%02d:%02d", hrs, mins, secs)
    end
end)

