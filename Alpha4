    LocalPlayer.CameraMaxZoomDistance = 400 
    LocalPlayer.CameraMinZoomDistance = 0.5

    timeChangerEnabled = false
    dynamicDayNightEnabled = false
    Lighting.ClockTime = originalClockTime
    noFogEnabled = false
    fullbrightEnabled = false
    shadowsDisabled = false
    dynamicEnabled = false
    dynamicActivated = false
    hdrEnabled = false
    
    if antiFlingEnabled then
        antiFlingEnabled = false
        ToggleAntiFling(false)
    end
    
    Lighting.FogEnd = originalFogEnd
    Lighting.FogStart = originalFogStart
    Lighting.FogColor = originalFogColor
    local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
    if atmo and originalAtmosphereDensity ~= nil then
        atmo.Density = originalAtmosphereDensity
        atmo.Offset = originalAtmosphereOffset
    end
    Lighting.Ambient = originalAmbient
    Lighting.Brightness = originalBrightness
    Lighting.GlobalShadows = originalShadows
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
    
    local Bloom = Lighting:FindFirstChild("AuraBloom")
    local ColorCorr = Lighting:FindFirstChild("AuraHDR")
    if Bloom then Bloom.Enabled = false end
    if ColorCorr then ColorCorr.Enabled = false end
    
    if optimizationEnabled then
        optimizationEnabled = false
        pcall(function() settings().Rendering.QualityLevel = originalQualityLevel end)
        if optimizationConnection then optimizationConnection:Disconnect() optimizationConnection = nil end
        for obj, data in pairs(optimizationCache) do
             if obj and obj.Parent then 
                 if data.Material then obj.Material = data.Material end
                  if data.Reflectance then obj.Reflectance = data.Reflectance end
            end
        end
        table.clear(optimizationCache)
    end

    if flyEnabled then
        flyEnabled = false
        if ToggleFly then ToggleFly(false) end
    end
end

