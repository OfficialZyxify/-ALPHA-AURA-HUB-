--// CLEANUP FUNCTIONS
local function RemoveESP(model)
    if not model then return end
    
    local items = {AuraBox = true, AuraTag = true, AuraChams = true}
    for _, child in ipairs(model:GetDescendants()) do
        if items[child.Name] then
             child:Destroy()
        end
    end

    if VF_Tracers[model] then
        if typeof(VF_Tracers[model]) == "Instance" then
            VF_Tracers[model]:Destroy()
        else
            VF_Tracers[model]:Remove()
        end
         VF_Tracers[model] = nil
    end
    BoundingBoxCache[model] = nil
end

local function ClearComputerESP()
    for obj, hl in pairs(ComputerESP_Cache) do
        if hl and typeof(hl) == "Instance" then hl:Destroy() end
    end
    table.clear(ComputerESP_Cache)
end

local function ClearAllESP()
    for _, item in pairs(CollectionService:GetTagged("AuraESP")) do item:Destroy() end
    table.clear(ESP_Data_Cache)
    
    for _, tracer in pairs(VF_Tracers) do
        if typeof(tracer) == "Instance" then tracer:Destroy() else tracer:Remove() end
    end
    table.clear(VF_Tracers)
    table.clear(BoundingBoxCache)
    
    for model, _ in pairs(NPCCache) do
        RemoveESP(model)
    end
    ClearComputerESP()
end

local function ClearPlayerESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then RemoveESP(p.Character) end
    end
end

local function ClearNPCESP()
    for model, _ in pairs(NPCCache) do
        RemoveESP(model)
    end
    table.clear(NPCCache)
    
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(v) then
            RemoveESP(v)
        end
    end
end

--// UNIVERSAL ROLE DETECTOR
local function GetUniversalRole(player)
    if not player then return "Unknown" end
    
    if player.Character then
        local hum = player.Character:FindFirstChild("Humanoid")
         
        local attrDown = player.Character:GetAttribute("Downed")
        local attrRev = player.Character:GetAttribute("Revive")
        local attrState = player.Character:GetAttribute("State")
        local findRev = player.Character:FindFirstChild("Revive")
 
        if attrDown == true or attrRev == true or (type(attrState) == "string" and attrState:lower():find("down")) or findRev then
            return "Downed"
         end

        if hum and hum.Health <= 0 then
            return "Dead"
        end

        local isMM2 = (game.PlaceId == 142823291)
        local isFTF = (game.PlaceId == 893973440)

        if isMM2 then
            local function checkItems(container)
                if not container then return nil end
                for _, item in pairs(container:GetChildren()) do
                    if item:IsA("Tool") then
                        local name = item.Name:lower()
                        if name == "knife" or name:find("dagger") or name:find("knife") or name:find("pitchfork") or name:find("saw") or name:find("scythe") then 
                             return "Murderer" 
                        end
                        if name == "gun" or name == "revolver" or name == "sheriff" then 
                            return "Sheriff" 
                        end
                    end
                end
                return nil
            end
             
            local mm2Role = checkItems(player.Character) or checkItems(player:FindFirstChild("Backpack"))
            if mm2Role then 
                return mm2Role 
            end
         end

        if isFTF then
            for _, child in pairs(player.Character:GetChildren()) do
                local name = child.Name:lower()
                if name:find("hammer") then
                    if child:IsA("Tool") then
                         return "Beast"
                    elseif child:IsA("Model") or child:IsA("BasePart") then
                        local attachedToHand = false
                         for _, weld in pairs(player.Character:GetDescendants()) do
                            if weld:IsA("Weld") or weld:IsA("Motor6D") or weld:IsA("WeldConstraint") then
                                if weld.Part0 and weld.Part1 then
                                     local isHammerPart = (weld.Part0:IsDescendantOf(child) or weld.Part0 == child) or (weld.Part1:IsDescendantOf(child) or weld.Part1 == child)
                                    if isHammerPart then
                                         local limb = (weld.Part0:IsDescendantOf(child) or weld.Part0 == child) and weld.Part1 or weld.Part0
                                        local limbName = limb.Name:lower()
                                         if limbName:find("right") and (limbName:find("arm") or limbName:find("hand")) then
                                            attachedToHand = true
                                             break
                                        end
                                    end
                                 end
                            end
                        end
                        if attachedToHand then
                             return "Beast"
                        end
                    end
                end
            end
        end
    end

    if player.Team then
        local tName = player.Team.Name:lower()
        if tName == "neutral" or tName == "lobby" or tName == "spectator" then return "Neutral" end
        return player.Team.Name
    end

    return "Neutral"
end

--// SMART COLOR ENGINE
local function GetSmartColor(role, player)
    local r = tostring(role):lower()
    if r == "downed" or r:find("down") then return Color3.fromRGB(255, 170, 0) end
    if r == "dead" or r:find("dead") or r:find("spectator") then return Color3.fromRGB(150, 150, 150) end
    if r == "beast" or r == "murderer" or r:find("murder") or r:find("traitor") or r:find("bad") or r == "red" then 
        return Color3.fromRGB(255, 40, 40) 
    end
    if r == "sheriff" or r:find("sheriff") or r:find("police") or r:find("good") or r == "blue" then return Color3.fromRGB(40, 100, 255) end
    if r == "neutral" or r == "lobby" or r == "nil" then return Color3.fromRGB(255, 255, 255) end
    if player.TeamColor then return player.TeamColor.Color end
    return Color3.fromRGB(255, 255, 255)
end

--// VISIBILITY CHECKER (General Purpose)
local function IsVisible(targetModel, ignoreList)
    if not targetModel then return false end
    local root = targetModel:FindFirstChild("HumanoidRootPart") or targetModel:FindFirstChild("Torso") or targetModel.PrimaryPart
    if not root then return false end
    
    local points = {
        root.Position,
        root.Position + Vector3.new(0, 1.5, 0),
        root.Position - Vector3.new(0, 1.5, 0)
    }
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = ignoreList
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    
    for _, point in ipairs(points) do
        local direction = point - origin
        local result = workspace:Raycast(origin, direction, params)
        if not result or result.Instance:IsDescendantOf(targetModel) then
             return true 
        end
    end
    return false 
end

--// VISIBILITY CHECKER (Strict Raycast for Aim Assist)
local function IsVisibleAim(targetPart, ignoreList)
    if not targetPart then return false end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin 
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = ignoreList
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    
    local result = workspace:Raycast(origin, direction, params)
    if not result or result.Instance:IsDescendantOf(targetPart.Parent) then
        return true 
    end
    return false
end

--// TARGET IDENTIFICATION (Center of Mass Aim Assist Friction)
local function GetClosestTarget()
    local closestDist = aimAssistFOV
    local closestTargetPart = nil
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local role = GetUniversalRole(p)
            if role == "Dead" or role == "Downed" then continue end
            if p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team and p.Team.Name ~= "Neutral" then continue end

            local bodyPart = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("UpperTorso")
            if bodyPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(bodyPart.Position)
                if onScreen then
                    local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if dist2D <= closestDist then
                        if IsVisibleAim(bodyPart, {LocalPlayer.Character, p.Character}) then
                            closestDist = dist2D
                            closestTargetPart = bodyPart
                        end
                    end
                end
            end
        end
    end
    return closestTargetPart
end

--// OPTIMIZED: BODY BOUNDING BOX CALCULATOR
local function GetBodyBoundingBox(character)
    local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
    if not root then return character:GetBoundingBox() end

    if BoundingBoxCache[character] and (tick() - BoundingBoxCache[character].Time < 0.5) then
        return root.CFrame * BoundingBoxCache[character].Offset, BoundingBoxCache[character].Size
    end

    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local hasParts = false
    local rootInv = root.CFrame:Inverse()

    for _, part in pairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            local size = part.Size
            local cf = rootInv * part.CFrame
            local corners = {
                cf * Vector3.new(size.X/2, size.Y/2, size.Z/2),
                cf * Vector3.new(size.X/2, size.Y/2, -size.Z/2),
                cf * Vector3.new(size.X/2, -size.Y/2, size.Z/2),
                cf * Vector3.new(size.X/2, -size.Y/2, -size.Z/2),
                cf * Vector3.new(-size.X/2, size.Y/2, size.Z/2),
                cf * Vector3.new(-size.X/2, size.Y/2, -size.Z/2),
                cf * Vector3.new(-size.X/2, -size.Y/2, size.Z/2),
                cf * Vector3.new(-size.X/2, -size.Y/2, -size.Z/2),
            }
            for _, pos in ipairs(corners) do
                minX = math.min(minX, pos.X)
                minY = math.min(minY, pos.Y)
                minZ = math.min(minZ, pos.Z)
                maxX = math.max(maxX, pos.X)
                maxY = math.max(maxY, pos.Y)
                maxZ = math.max(maxZ, pos.Z)
            end
            hasParts = true
        end
    end

    if hasParts then
        local centerLocal = Vector3.new((minX + maxX)/2, (minY + maxY)/2, (minZ + maxZ)/2)
        local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
        local offsetCFrame = CFrame.new(centerLocal)
        BoundingBoxCache[character] = { Offset = offsetCFrame, Size = size, Time = tick() }
        return root.CFrame * offsetCFrame, size
    else
        return character:GetBoundingBox()
    end
end

--// TRACER ORIGIN CALCULATOR
local function GetTracerOrigin()
    if LocalPlayer.Character and LocalPlayer.Character.PrimaryPart then
        local cframe, size = GetBodyBoundingBox(LocalPlayer.Character)
        local feetPos = cframe.Position - Vector3.new(0, size.Y / 2, 0)
        local screenPos, onScreen = Camera:WorldToViewportPoint(feetPos)
        if onScreen then
            return Vector2.new(screenPos.X, screenPos.Y)
        end
    end
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
end

--// Server Hopper
local function StableServerHop()
    Notify("Searching for Stable Server...")
    local Success, Result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100")).data
     end)
    if Success then
        local PossibleServers = {}
        for _, server in pairs(Result) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                table.insert(PossibleServers, server.id)
            end
        end
        if #PossibleServers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, PossibleServers[math.random(1, #PossibleServers)])
        end
    end
end

--// Rejoin Function
local function RejoinServer()
    Notify("Rejoining Server...")
    if #Players:GetPlayers() <= 1 then
        LocalPlayer:Kick("\nRejoining...")
        task.wait()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    else
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
end

