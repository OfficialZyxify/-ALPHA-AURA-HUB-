--// Aim Assist
CreateButton("Toggle Aim Assist", function()
    aimAssistEnabled = not aimAssistEnabled
    if aimAssistEnabled then
        if not aimAssistConnection then
            aimAssistConnection = RunService.RenderStepped:Connect(function()
                pcall(function()
                    if aimAssistEnabled then
                        local target = nil
                        local closestDist = aimAssistFOV
                        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        
                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer and p.Character then
                                local root = p.Character:FindFirstChild("HumanoidRootPart")
                                if root then
                                    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                                    if onScreen then
                                        local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                                        if dist2D < closestDist then
                                            closestDist = dist2D
                                            target = root
                                        end
                                    end
                                end
                            end
                        end
                        
                        if target then
                            local targetDir = (target.Position - Camera.CFrame.Position).Unit
                            local camDir = Camera.CFrame.LookVector
                            local newDir = camDir:Lerp(targetDir, aimAssistSmoothing)
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + newDir)
                        end
                    end
                end)
            end)
        end
        Notify("Aim Assist Enabled")
    else
        if aimAssistConnection then
            aimAssistConnection:Disconnect()
            aimAssistConnection = nil
        end
        Notify("Aim Assist Disabled")
    end
end)

