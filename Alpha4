    n.Font = Enum.Font.GothamBold
    n.TextSize = 14
    n.ZIndex = 999999999
    n.Parent = ScreenGui
    Instance.new("UICorner", n)
    local Stroke = Instance.new("UIStroke", n)
    Stroke.Color = Color3.fromRGB(0, 255, 140)
    Stroke.Transparency = 0.6
    n:TweenPosition(UDim2.new(0.5, -140, 0.05, 0), "Out", "Back", 0.5, true)
    task.delay(3, function()
        if n and n.Parent then
            n:TweenPosition(UDim2.new(0.5, -140, -0.1, 0), "In", "Quad", 0.5, true, function()
                pcall(function() n:Destroy() end)
            end)
        end
    end)
end

--// Cleanup Functions
local function RemoveESP(model)
    if not model then return end
    pcall(function()
        for _, child in ipairs(model:GetDescendants()) do
            if child.Name == "AuraBox" or child.Name == "AuraTag" then
                child:Destroy()
            end
        end
    end)
    if VF_Tracers[model] then
        pcall(function() 
            if typeof(VF_Tracers[model]) == "Instance" then
                VF_Tracers[model]:Destroy()
            end
        end)
    end
    VF_Tracers[model] = nil
    BoundingBoxCache[model] = nil
end

local function ClearAllESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then RemoveESP(p.Character) end
    end
    table.clear(ESP_Data_Cache)
    table.clear(VF_Tracers)
end

