local function UpdateESPRuntimeEngine()
    if not espEnabled then ClearAllESP() return end
    
    local function processModel(model, isNPC, nameStr)
        if not model or not model:FindFirstChild("HumanoidRootPart") then return end
        local role = isNPC and "NPC" or GetUniversalRole(Players:GetPlayerFromCharacter(model))
        local smartColor = isNPC and Color3.fromRGB(200, 0, 255) or GetSmartColor(role, Players:GetPlayerFromCharacter(model))
        
        -- Box ESP
        local box = model:FindFirstChild("AuraBox")
        if espShowBoxes then
            if not box then
                box = Instance.new("BoxHandleAdornment")
                box.Name = "AuraBox"
                box.AlwaysOnTop = true
                box.ZIndex = 5
                box.Adornee = model:FindFirstChild("HumanoidRootPart")
                box.Transparency = 0.5
                box.Parent = model
                CollectionService:AddTag(box, "AuraESP")
            end
            local _, bSize = GetBodyBoundingBox(model)
            box.Size = bSize
            box.Color3 = smartColor
        elseif box then
            box:Destroy()
        end

        -- Name Tags
        local tag = model:FindFirstChild("AuraTag")
        if espShowNames then
            if not tag then
                tag = Instance.new("BillboardGui")
                tag.Name = "AuraTag"
                tag.Size = UDim2.new(0, 150, 0, 30)
                tag.AlwaysOnTop = true
                tag.StudsOffset = Vector3.new(0, 3.5, 0)
                tag.Parent = model
                CollectionService:AddTag(tag, "AuraESP")
                
                local lbl = Instance.new("TextLabel", tag)
                lbl.Size = UDim2.new(1, 0, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 11
            end
            local lbl = tag:FindFirstChildOfClass("TextLabel")
            if lbl then
                lbl.Text = nameStr .. " [" .. role .. "]"
                lbl.TextColor3 = smartColor
            end
        elseif tag then
            tag:Destroy()
        end

        -- Chams Engine Implementation
        local chams = model:FindFirstChild("AuraChams")
        if espShowChams then
            if not chams then
                chams = Instance.new("Highlight")
                chams.Name = "AuraChams"
                chams.Parent = model
                CollectionService:AddTag(chams, "AuraESP")
            end
            chams.FillColor = smartColor
            chams.OutlineColor = Color3.new(1, 1, 1)
            chams.FillTransparency = espWallsOnly and 1 or 0.4
            chams.OutlineTransparency = 0
            chams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        elseif chams then
            chams:Destroy()
        end

        -- Drawing API Viewport Tracers
        if espShowTracers then
            local root = model:FindFirstChild("HumanoidRootPart")
            if root then
                local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local tracer = VF_Tracers[model]
                    if not tracer then
                        if pcall(function() Drawing.new("Line") end) then
                            tracer = Drawing.new("Line")
                            tracer.Thickness = 1.5
                        else
                            tracer = Instance.new("Frame", ScreenGui)
                            tracer.BorderSizePixel = 0
                            CollectionService:AddTag(tracer, "AuraESP")
                        end
                        VF_Tracers[model] = tracer
                    end
                    
                    local origin = GetTracerOrigin()
                    if typeof(tracer) == "Instance" then
                        local startPos = origin
                        local endPos = Vector2.new(screenPos.X, screenPos.Y)
                        local dist = (endPos - startPos).Magnitude
                        tracer.Size = UDim2.new(0, dist, 0, 2)
                        tracer.Position = UDim2.new(0, startPos.X, 0, startPos.Y)
                        tracer.Rotation = math.deg(math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X))
                        tracer.BackgroundColor3 = smartColor
                        tracer.Visible = true
                    else
                        tracer.From = origin
                        tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                        tracer.Color = smartColor
                        tracer.Visible = true
                    end
                elseif VF_Tracers[model] then
                    if typeof(VF_Tracers[model]) == "Instance" then VF_Tracers[model].Visible = false else VF_Tracers[model].Visible = false end
                end
            end
        elseif VF_Tracers[model] then
            if typeof(VF_Tracers[model]) == "Instance" then VF_Tracers[model]:Destroy() else VF_Tracers[model]:Remove() end
            VF_Tracers[model] = nil
        end
    end

    if espShowPlayers then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                processModel(p.Character, false, p.DisplayName)
            end
        end
    else
        ClearPlayerESP()
    end

    if espShowNPCs then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(v) then
                NPCCache[v] = true
                processModel(v, true, v.Name)
            end
        end
    else
        ClearNPCESP()
    end

    -- Flee the Facility Specific Computer Modules
    if game.PlaceId == 893973440 then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name == "Computer" and obj:IsA("Model") then
                local screen = obj:FindFirstChild("Screen") or obj:FindFirstChild("Keyboard")
                if screen then
                    local hl = ComputerESP_Cache[obj]
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "AuraChams_Computer"
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = obj
                        ComputerESP_Cache[obj] = hl
                    end
                    hl.FillColor = Color3.fromRGB(0, 180, 255)
                    hl.OutlineColor = Color3.new(1, 1, 1)
                    hl.FillTransparency = 0.5
                end
            end
        end
    else
        ClearComputerESP()
    end
end

