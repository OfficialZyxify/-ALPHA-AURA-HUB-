    local rulerColor = dimmed and Color3.fromRGB(60, 60, 60) or Color3.fromRGB(180, 180, 180)
    local dotColor = dimmed and Color3.fromRGB(120, 30, 30) or Color3.fromRGB(255, 50, 50)
    
    for _, item in ipairs(SpeedVisuals.ActiveItems) do
        if item:IsA("TextLabel") then
            item.TextColor3 = (item.Text:match("%d") and not item.Text:find("WalkSpeed")) and rulerColor or targetColor
        end
    end
    SliderDotSpeed.BackgroundColor3 = dotColor
    SpeedNote.Visible = dimmed
end
