--// Get Secure GUI Parent
local function GetSafeParent()
    local success, result = pcall(function()
        if gethui then return gethui() end
        return CoreGui
    end)
    if success and result then return result end
    return PlayerGui
end

--// DEEP CLEANUP
local function DeepClean()
    local targetSpaces = {PlayerGui}
    pcall(function() table.insert(targetSpaces, GetSafeParent()) end)
    for _, space in ipairs(targetSpaces) do
        for _, oldGui in pairs(space:GetChildren()) do
            if oldGui.Name:match("AuraHub") then pcall(function() oldGui:Destroy() end) end
        end
    end
    for _, item in pairs(CollectionService:GetTagged("AuraESP")) do pcall(function() item:Destroy() end) end
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "AuraBox" or v.Name == "AuraTag" or v.Name == "AuraChams" then
            pcall(function() v:Destroy() end)
        end
    end
end
